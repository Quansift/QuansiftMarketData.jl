# Required for Tiingo collection
TIINGO_API_KEY=your_tiingo_api_key

# Optional library/runtime overrides
# TIINGO_API_KEY_NAME=TIINGO_API_KEY
# TIINGO_ENV_FILE=.env
# TIINGO_CONFIG_PATH=./config.toml
# DuckDB is an optional local-analysis and compatibility sink.
# OHLCV_DUCKDB_PATH=./data/tiingo_analysis.duckdb
# Used only by helpers or smoke tests that export to PostgreSQL. Library callers
# may instead pass an already-open LibPQ connection to the persistence APIs.
# OHLCV_PG_CONNECTION=postgresql://user:password@host:5432/database?sslmode=require
# Legacy aliases TIINGO_DB_PATH / DUCKDB_PATH / TIINGO_DUCKDB_PATH / TIINGO_PG_CONNECTION still honored.
# TIINGO_LOG_FILE=./stock.log
# TIINGO_LOGGER=console
# TIINGO_API_BASE_URL=https://api.tiingo.com/tiingo/daily
# TIINGO_TICKERS_URL=https://apimedia.tiingo.com/docs/tiingo/daily/supported_tickers.zip
# TIINGO_API_MAX_RETRIES=3
# TIINGO_API_RETRY_DELAY=2
# TIINGO_TICKERS_ZIP=./supported_tickers.zip
# TIINGO_TICKERS_CSV=./supported_tickers.csv
# TIINGO_DUCKDB_TMP=/tmp/duckdb
# TIINGO_DUCKDB_MEMORY_LIMIT_GB=4
# TIINGO_DUCKDB_THREADS=4
# TIINGO_DUCKDB_WORKER_THREADS=3
# TIINGO_DUCKDB_PRESERVE_INSERTION_ORDER=false
# TIINGO_DUCKDB_UPSERT_CHUNK_SIZE=1000
# TIINGO_SUPPORTED_EXCHANGES=NYSE,NASDAQ,NYSE ARCA,AMEX,ASX
# TIINGO_SUPPORTED_ASSET_TYPES=Stock,ETF
# TIINGO_TEST_LIVE_API=false
# Opt-in executable persistence test. Use an isolated disposable database only;
# the test creates, replaces, and drops Tiingo tables.
# TIINGO_TEST_PG_CONNECTION=postgresql://user:password@localhost:5432/tiingojulia_test?sslmode=disable

# Optional bounded integration-smoke settings. These do not define a production
# scheduler; scripts/staging_smoke_test.jl is a validation example only.
# TIINGO_SMOKE_TICKER_LIMIT=25

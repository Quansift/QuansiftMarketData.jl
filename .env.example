# Required
TIINGO_API_KEY=your_tiingo_api_key

# Optional overrides used by the package/runtime
# TIINGO_API_KEY_NAME=TIINGO_API_KEY
# TIINGO_ENV_FILE=.env
# TIINGO_CONFIG_PATH=./config.toml
# TIINGO_DB_PATH=./tiingo_historical_data.duckdb
# TIINGO_PG_CONNECTION=postgresql://user:password@host:5432/database?sslmode=require
# TIINGO_LOG_FILE=./stock.log
# TIINGO_LOGGER=console
# TIINGO_API_BASE_URL=https://api.tiingo.com/tiingo/daily
# TIINGO_TICKERS_URL=https://apimedia.tiingo.com/docs/tiingo/daily/supported_tickers.zip
# TIINGO_API_MAX_RETRIES=3
# TIINGO_API_RETRY_DELAY=2
# TIINGO_TICKERS_ZIP=./supported_tickers.zip
# TIINGO_TICKERS_CSV=./supported_tickers.csv
# TIINGO_DUCKDB_TMP=/tmp/duckdb
# TIINGO_SUPPORTED_EXCHANGES=NYSE,NASDAQ,NYSE ARCA,AMEX,ASX
# TIINGO_SUPPORTED_ASSET_TYPES=Stock,ETF
# TIINGO_TEST_LIVE_API=false

# Current scheduled pipeline settings
# The existing containerized scheduler runs scripts/staging_smoke_test.jl.
# Increase TIINGO_SMOKE_TICKER_LIMIT gradually as you promote from preprod to prod.
# TIINGO_SMOKE_TICKER_LIMIT=25
# TIINGO_SMOKE_BATCH_SIZE=25
# TIINGO_SMOKE_MAX_CONCURRENT=5
# TIINGO_SMOKE_USE_PARALLEL=false
# TIINGO_SMOKE_EXPORT_POSTGRES=false

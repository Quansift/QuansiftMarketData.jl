# Bounded integration-smoke example; not a production scheduler configuration.
# Required for the live Tiingo smoke.
TIINGO_API_KEY=replace_me_with_real_tiingo_api_key

# Low-resource smoke defaults. DuckDB is temporary local validation state.
TIINGO_LOGGER=console
OHLCV_DUCKDB_PATH=./data/staging_smoke.duckdb
# Legacy aliases TIINGO_DB_PATH / DUCKDB_PATH / TIINGO_DUCKDB_PATH still honored.
TIINGO_DUCKDB_TMP=./.duckdb_temp
TIINGO_DUCKDB_MEMORY_LIMIT_GB=1
TIINGO_DUCKDB_THREADS=1
TIINGO_DUCKDB_WORKER_THREADS=1
TIINGO_DUCKDB_PRESERVE_INSERTION_ORDER=false
TIINGO_DUCKDB_UPSERT_CHUNK_SIZE=500

# Optional PostgreSQL integration target for the smoke only.
# For docker-networked droplets, prefer postgres:5432 with sslmode=disable.
OHLCV_PG_CONNECTION=postgresql://user:password@host:5432/database?sslmode=require
# Legacy alias TIINGO_PG_CONNECTION still honored.
# PostgreSQL-to-Parquet validation also requires DuckDB's postgres extension to
# be preinstalled in the image/environment; runtime downloads are disabled.

# Bounded live scope
TIINGO_SMOKE_TICKER_LIMIT=25
TIINGO_SMOKE_EXPORT_POSTGRES=false

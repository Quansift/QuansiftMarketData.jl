<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.tiingojulia.staging-smoke</string>

    <key>ProgramArguments</key>
    <array>
        <string>~/<user>/TiingoJulia/scripts/run_staging_smoke.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>~/<user>/TiingoJulia</string>

    <key>RunAtLoad</key>
    <false/>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>~/<user>/TiingoJulia/logs/staging_smoke.out.log</string>

    <key>StandardErrorPath</key>
    <string>~/<user>/TiingoJulia/logs/staging_smoke.err.log</string>
</dict>
</plist>

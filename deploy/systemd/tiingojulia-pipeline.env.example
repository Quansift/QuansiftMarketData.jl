# Host-side variables consumed by systemd before docker compose starts.
# Copy to /etc/default/tiingojulia-pipeline and adjust per environment.

# GHCR image tag to run.
TIINGO_IMAGE_TAG=staging

# Repo-local application env file passed to docker compose env_file:.
TIINGO_APP_ENV_FILE=/opt/tiingojulia/.env.staging

# External Docker network exposed by the DB stack.
TIINGO_DOCKER_NETWORK=db-net
